{
  "name": "clinique",
  "version": "0.1.0",
  "private": true,
  "description": "Clinique — gestion des patients pour un centre de santé (dossiers, consultations, file d'attente, facturation)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace backend",
    "db:seed": "npm run seed --workspace backend",
    "db:reset": "npm run reset --workspace backend",
    "start": "npm run start --workspace backend",
    "serve": "npm run build && npm run start --workspace backend"
  },
  "engines": {
    "node": ">=20"
  }
}
