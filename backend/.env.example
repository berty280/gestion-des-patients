# --- Clinique backend configuration ---

# HTTP server
PORT=3000
HOST=0.0.0.0

# Comma-separated list of allowed origins for CORS (frontend dev server, etc.)
CORS_ORIGIN=http://localhost:5173

# SQLite database file (relative to backend/ or absolute)
DATABASE_PATH=./data/clinique.db

# Auth
JWT_SECRET=change-me-in-production

# Default passwords assigned to seeded accounts (dev only — change in production)
SEED_DEFAULT_PASSWORD=clinique123

# Identité du centre de santé (valeurs par défaut ; modifiables ensuite dans
# l'application via Admin → Paramètres, qui prennent alors le dessus).
CLINIC_NAME=Centre de Santé
CLINIC_ADDRESS=Yaoundé, Cameroun
CLINIC_PHONE=

# --- Sauvegarde automatique de la base ---
# Activer/désactiver la sauvegarde automatique (true/false)
BACKUP_ENABLED=true
# Dossier des sauvegardes (mettre le chemin d'une clé USB / disque externe en prod,
# ex. E:/sauvegardes-clinique). Par défaut : à côté de la base.
BACKUP_DIR=./data/backups
# Intervalle entre deux sauvegardes automatiques (en heures)
BACKUP_INTERVAL_HOURS=24
# Nombre de sauvegardes à conserver (les plus anciennes sont supprimées)
BACKUP_KEEP=30
# Faire une sauvegarde au démarrage du serveur (true/false)
BACKUP_ON_START=true
